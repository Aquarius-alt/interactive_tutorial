#include <windows.h>

// Иконка exe (и окна в панели задач). Идентификатор 1 SDL использует как иконку окна по умолчанию.
1 ICON "mark.ico"

// PRO CUTE wallpapers (see Wallpapers.h): RCDATA 301..309, loaded from the exe at runtime.
301 RCDATA "wallpapers/wp01.png"
302 RCDATA "wallpapers/wp02.png"
303 RCDATA "wallpapers/wp03.png"
304 RCDATA "wallpapers/wp04.png"
305 RCDATA "wallpapers/wp05.png"
306 RCDATA "wallpapers/wp06.png"
307 RCDATA "wallpapers/wp07.png"
308 RCDATA "wallpapers/wp08.png"
309 RCDATA "wallpapers/wp09.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Aqua femboy"
            VALUE "FileDescription", "aquadeck"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "aquadeck"
            VALUE "OriginalFilename", "aquadeck.exe"
            VALUE "ProductName", "aquadeck"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
